# Shared editor settings. See CONTRIBUTING.md for the rest of the style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown gives meaning to a two-space line ending.
trim_trailing_whitespace = false

[LICENSE]
indent_size = unset
trim_trailing_whitespace = false
